# Supabase (required for Vercel deployment)
# Get these from your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key (server-only): used for PIN login, user list, set-pin. Do not expose to client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: Capacitor iOS app — URL the WebView loads (e.g. https://your-app.vercel.app or http://localhost:3003)
# CAPACITOR_SERVER_URL=
# CAPACITOR_CLEARTEXT=true
