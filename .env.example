# Supabase (required for deployment)
# Get these from your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key (server-only): required for leaderboard (all users' points), PIN login, user list, set-pin. Do not expose to client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: same URL for server-side scripts (Next.js uses NEXT_PUBLIC_* for client)
# SUPABASE_URL=https://your-project.supabase.co

# App URL (required for Slack images, Capacitor iOS, etc.) — set to your deployed URL
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Optional: Capacitor iOS app — override WebView URL (defaults to NEXT_PUBLIC_APP_URL or localhost)
# CAPACITOR_SERVER_URL=
# CAPACITOR_CLEARTEXT=true

# Food NL parsing (Gemini) — required for "Generate using AI" in food logging
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite

# Cron secret — required to secure /api/cron/daily-reminders and /api/cron/health-digest
# Generate with: openssl rand -hex 32
# CRON_SECRET=

# Slack — required for channel posts (webhook) and DMs / user lookup (bot token)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# SLACK_BOT_TOKEN=xoxb-...
